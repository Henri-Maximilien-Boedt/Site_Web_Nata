<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="stylesheet" href="/css/fonts.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/reservation.css" />
  </head>
  <body>
    <div class="noise"></div>

    <%- include('partials/header', { currentPath: '/reservation' }) %>

    <main>
      <%- include('partials/announcement', { banners: typeof banners !== 'undefined' ? banners : [] }) %>

      <section class="story reveal">
        <div class="story-card">
          <p class="eyebrow">Réservation</p>
          <h2>Réserve ta table</h2>
          <p>Choisis ta date et envoie-nous ta demande de réservation.</p>
        </div>
      </section>

      <section class="contact reveal">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>NATA</h2>
          <p>Bar ouvert du lundi au samedi, <%= displayHours.bar[0].value %>.</p>
          <p>Service en cuisine : <%= displayHours.kitchen[0].value %>.</p>
          <p>Grand-Place 51, 1348 Ottignies-Louvain-la-Neuve</p>
          <p>Tél: 01 23 45 67 89</p>
        </div>
        <form class="booking-form" action="/reservation" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            Nom
            <input type="text" name="name" placeholder="Ton nom" required />
          </label>
          <label>
            Email
            <input type="email" name="email" placeholder="nom@email.com" required />
          </label>
          <label>
            Téléphone
            <input type="tel" name="phone" placeholder="Ex: 0470 12 34 56" required />
          </label>
          <label>
            Nombre de personnes
            <input type="number" name="people" min="1" max="18" placeholder="Ex: 4" required />
          </label>
          <label>
            Date
            <div class="date-picker" data-date-picker>
              <input type="hidden" name="date" data-date-value />
              <input
                type="text"
                class="date-trigger"
                data-date-trigger
                placeholder="Cliquez pour choisir une date"
                readonly
                required
              />
              <p class="date-help">Cliquez sur le champ pour ouvrir le sélecteur grand format.</p>
            </div>
          </label>
          <label>
            Heure
            <div class="time-picker" data-time-picker>
              <input type="hidden" name="time" data-time-value />
              <input
                type="text"
                class="time-trigger"
                data-time-trigger
                placeholder="Sélectionnez d'abord une date"
                readonly
                required
              />
              <p class="date-help"></p>
            </div>
          </label>
          <p class="booking-note">
            La table est attribuée automatiquement selon la taille de votre groupe.
            À partir de 7 personnes, nous vous recontactons pour l'organiser.
          </p>
          <label>
            Message
            <textarea name="message" rows="4" placeholder="Nombre de personnes, heure..."></textarea>
          </label>
          <p class="form-privacy">
            Vos coordonnées servent uniquement à gérer votre réservation et sont supprimées quelques jours après votre venue.
            <a href="/politique-confidentialite">En savoir plus sur vos données</a>.
          </p>
          <button type="submit" class="btn btn-primary">Envoyer</button>
        </form>
      </section>

      <section class="cancel-booking reveal">
        <details class="cancel-booking__box">
          <summary class="cancel-booking__toggle">Annuler ma réservation</summary>
          <form class="cancel-booking__form" data-cancel-form novalidate>
            <p class="cancel-booking__hint">
              Indique le nom, l'email et le téléphone utilisés lors de ta réservation.
            </p>
            <label>
              Nom
              <input type="text" name="name" autocomplete="name" maxlength="120" required />
            </label>
            <label>
              Email
              <input type="email" name="email" autocomplete="email" maxlength="200" required />
            </label>
            <label>
              Téléphone
              <input type="tel" name="phone" autocomplete="tel" maxlength="30" required />
            </label>
            <p class="form-privacy">
              Ces informations servent uniquement à retrouver votre réservation ; elles ne sont pas enregistrées.
              <a href="/politique-confidentialite">En savoir plus sur vos données</a>.
            </p>
            <button type="submit" class="btn cancel-booking__submit">Annuler ma réservation</button>
            <p class="booking-feedback" data-cancel-feedback aria-live="polite"></p>
          </form>
        </details>
      </section>
    </main>

    <%- include('partials/footer') %>

    <textarea id="nata-state" hidden><%- typeof clientStateJson !== 'undefined' ? clientStateJson : '{}' %></textarea>
    <script>window.__csrfToken = '<%= csrfToken %>';</script>
    <script src="/js/app.js"></script>
  </body>
</html>
